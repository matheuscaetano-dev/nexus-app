# Front-end Nexus: copie este arquivo para .env e configure o endereço do backend.
# Não coloque senhas, tokens privados ou chaves secretas em variáveis EXPO_PUBLIC_*.
# Em aparelho físico, use o IP da máquina na rede ou a URL HTTPS do backend.
EXPO_PUBLIC_API_URL=
# "true" usa dados simulados; "false" conecta à API acima.
EXPO_PUBLIC_USAR_MOCK=false
